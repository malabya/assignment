<div class="relative rounded-lg border shadow-lg max-w-[384px] bg-white">
  <div class="flex flex-col items-center justify-center border-b border-gray-200 py-8">
    <div class="rounded-full overflow-hidden w-fit mb-10">
      <img src="{{image}}" alt="{{alt}}">
    </div>

    <div class="text-sm leading-5 font-medium mb-2 px-8 text-align-center">{{name}}</div>
    <div class="text-sm leading-5 font-normal text-gray-500 mb-2 px-8 text-align-center">{{organization}}</div>
    <div class="bg-green-100 text-green-800 text-xs font-medium me-2 px-2.5 py-0.5 rounded-full">{{designation}}</div>
  </div>
  <div class="grid grid-flow-row grid-cols-2 divide-x-2 divide-gray-200 divide-solid text-sm leading-5 font-medium text-gray-700">
    <div class="relative overflow-hidden py-4 hover:bg-gray-50 rounded-bl-lg">
      <a href="mailto:{{email}}" class="flex items-center justify-center gap-1 after:content-[''] after:absolute after:w-full after:h-full">
        {% include "@server_theme/../src/images/mail.svg" %}
        <span>{{"Email"|t}}</span>
      </a>
    </div>
    <div class="relative overflow-hidden py-4 hover:bg-gray-50 rounded-br-lg">
      <a href="tel:{{phone}}" class="flex items-center justify-center gap-1 after:content-[''] after:absolute after:w-full after:h-full">
      {% include "@server_theme/../src/images/phone.svg" %}
      <span>{{"Call"|t}}</span>
      </a>
    </div>
  </div>
</div>
